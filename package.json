{
  "name": "sistema_restaurante",
  "version": "2.1.0",
  "description": "Servidor Backend POS Restaurante",
  "main": "bundle.cjs",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "build:server": "esbuild server.js --bundle --platform=node --target=node18 --format=cjs --outfile=bundle.cjs --external:pg-native --external:mock-aws-s3 --external:aws-sdk --external:nock",
    "package:win": "npm run build:server && pkg bundle.cjs --targets node18-win-x64 --output ServidorPOS.exe --no-bytecode --public"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "frontend-restaurante/dist/**/*"
    ]
  }
}
