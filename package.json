{
  "name": "sistema_restaurante",
  "version": "2.1.0",
  "description": "Servidor Backend POS Restaurante",
  "main": "bundle.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc --build",
    "build:esbuild": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node --test \"tests/*.test.mjs\"",
    "build:server:legacy": "esbuild server.js --bundle --platform=node --target=node18 --format=cjs --outfile=bundle.cjs --external:pg-native --external:mock-aws-s3 --external:aws-sdk --external:nock",
    "package:win": "npm run build:server:legacy && pkg bundle.cjs --targets node18-win-x64 --output ServidorPOS.exe --no-bytecode --public"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/ui": "^4.1.11",
    "c8": "^12.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "pkg": "^5.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pkg": {
    "assets": [
      "frontend-restaurante/dist/**/*"
    ]
  }
}
