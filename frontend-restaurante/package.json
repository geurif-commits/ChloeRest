{
  "name": "chloerestaurant",
  "private": true,
  "version": "2.4.1",
  "description": "ChloeRestaurant — Sistema de gestión para restaurantes",
  "author": "ChloeRestaurant",
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:pack": "npm run package:win --prefix .. && vite build && npm run predist && electron-builder --dir",
    "predist": "node scripts/predist.cjs",
    "dist": "npm run package:win --prefix .. && vite build && npm run predist && electron-builder && npm run postdist",
    "postdist": "node scripts/postdist.cjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.29.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.chloerestaurant.pos",
    "productName": "ChloeRestaurant",
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      "ServidorPOS.exe",
      "ServidorPOS.cjs",
      ".env",
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChloeRestaurant",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Desinstalar ChloeRestaurant",
      "differentialPackage": false
    }
  }
}
