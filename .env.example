# Archivo de ejemplo .env - COPIA este archivo a .env y completa los valores

# Servidor
NODE_ENV=development
PORT=3000
API_HOST=0.0.0.0
UPLOADS_DIR=uploads
# En producción las migraciones se ejecutan con un rol DDL separado.
RUN_MIGRATIONS=0

# Base de datos (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=postgres
DB_PASSWORD=
DB_PORT=5432

# Seguridad
# En producción son OBLIGATORIOS APP_SESSION_SECRET, BOOTSTRAP_ADMIN_PIN y CORS_ORIGINS.
# APP_SESSION_SECRET: cadena larga y aleatoria (base64url o similar).
APP_SESSION_SECRET=
SESSION_HOURS=8

# PIN inicial del administrador. En producción debe tener exactamente 6 dígitos.
BOOTSTRAP_ADMIN_PIN=

# Llave de activación de licencia (si aplica)
LICENSE_ACTIVATION_KEY=

# Tiempo en minutos para autorizaciones de supervisor
SUPERVISOR_AUTHORIZATION_MINUTES=5

# Protección anti fuerza bruta en el login (PIN)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=5

# Orígenes CORS permitidos (coma-separados)
# Producción: usa únicamente URLs HTTPS reales, por ejemplo:
# CORS_ORIGINS=https://chloerest.com,https://www.chloerest.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Respaldos automáticos (ver docs/OPERACION.md). Las tablas de negocio tienen RLS forzado:
# el rol que respalda debe ser superusuario o tener BYPASSRLS (BACKUP_DB_USER / BACKUP_DB_PASSWORD).
BACKUP_ENABLED=0
BACKUP_DIR=backups/auto
# Segunda carpeta donde se copia cada respaldo verificado (USB, OneDrive/Dropbox, recurso de red).
# BACKUP_COPY_DIR=
BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=14
# BACKUP_DB_USER=
# BACKUP_DB_PASSWORD=
# PG_BIN_DIR=
# Solo instalaciones de un negocio: el Administrador ve y descarga los respaldos.
# BACKUP_TENANT_ACCESS=1

# Límites de solicitudes públicas (por IP, cada 10 minutos)
# DEVICE_REGISTER_RATE_MAX=300
# PUBLIC_RATE_MAX=30

# NOTAS:
# - Nunca comitees el archivo .env real en repositorios públicos.
# - En producción usa NODE_ENV=production.
# - El servidor rechazará arrancar si faltan DB_PASSWORD, APP_SESSION_SECRET,
#   BOOTSTRAP_ADMIN_PIN o CORS_ORIGINS en producción.
# - No uses contraseñas o secretos reales en este archivo de ejemplo.
