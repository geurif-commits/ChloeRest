# Archivo de ejemplo .env - COPIA este archivo a .env y completa los valores

# Servidor
PORT=3000
API_HOST=0.0.0.0
UPLOADS_DIR=uploads

# Base de datos (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=pos_db
DB_PASSWORD=supersecretpassword
DB_PORT=5432

# Seguridad
# - En producción es OBLIGATORIO definir APP_SESSION_SECRET
# - Proporciona una cadena larga aleatoria (base64url o similar)
APP_SESSION_SECRET=
SESSION_HOURS=8

# PIN inicial opcional (solo si quieres crear Admin con PIN conocido)
# Si no se establece, el sistema generará un PIN temporal seguro la primera vez.
BOOTSTRAP_ADMIN_PIN=

# Llave de activación de licencia (si aplica)
LICENSE_ACTIVATION_KEY=

# Tiempo en minutos para autorizaciones de supervisor
SUPERVISOR_AUTH_MINUTES=5

# Protección anti fuerza bruta en el login (PIN)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=5

# Orígenes CORS permitidos (coma-separados)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NOTAS:
# - Nunca comitees el archivo .env real en repositorios públicos.
# - Usa un gestor de secretos para producción y establece NODE_ENV=production.
# - Asegúrate de fijar APP_SESSION_SECRET en producción para evitar que el servidor arranque con secretos generados en runtime.
